# Configurações do ConcursAI
# Copie este arquivo para .env e preencha com seus valores

# === DATABASE ===
DATABASE_URL=sqlite:///./data/concursai.db
CHROMADB_PATH=./data/chromadb

# === SECURITY ===
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === AI SERVICES ===
# Groq API (recomendado - gratuito em groq.com, necessário para respostas com IA)
GROQ_API_KEY=your-groq-api-key-here
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-key-if-needed

# === EXTERNAL APIS ===
# Os dados de concursos vêm de web scraping (não precisa de chave).
# BrasilAPI (feriados, CNPJ de órgãos) é pública e gratuita — também sem chave.
# Não existe uma "API de concursos" gratuita que exija cadastro/chave.

# ==========================================
# REDIS / CACHE
# ==========================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
ENABLE_CACHE=true

# ==========================================
# RATE LIMITING
# ==========================================
ENABLE_RATE_LIMITING=true
GLOBAL_RATE_LIMIT_PER_MINUTE=100
GLOBAL_RATE_LIMIT_PER_HOUR=1000

# === CORS ===
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# === MONITORING ===
ENABLE_METRICS=true
METRICS_PORT=9090

# === EMAIL (para notificações) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@concursai.com

# === DEVELOPMENT ===
DEBUG=false
ENVIRONMENT=development
